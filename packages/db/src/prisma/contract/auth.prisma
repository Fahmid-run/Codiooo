//use prisma-8
model User {
  id                 String              @id(map: "user_pkey")
  name               String
  email              String              @unique(map: "user_email_key")
  emailVerified      Boolean             @map("email_verified")
  image              String?
  collaborationRooms CollaborationRoom[]
  projects           Project[]
  projectmembers     ProjectMember[]
  accounts           Account[]
  sessions           Session[]
  documents          Document[]
  createdAt          TimestamptzString   @default(now()) @map("created_at")
  updatedAt          TimestamptzString   @default(now()) @map("updated_at")

  @@map("user")
}

model Account {
  id                    String             @id(map: "account_pkey")
  accountId             String             @map("account_id")
  providerId            String             @map("provider_id")
  userId                String             @map("user_id")
  accessToken           String?            @map("access_token")
  refreshToken          String?            @map("refresh_token")
  idToken               String?            @map("id_token")
  accessTokenExpiresAt  TimestamptzString? @map("access_token_expires_at")
  refreshTokenExpiresAt TimestamptzString? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             TimestamptzString  @default(now()) @map("created_at")
  updatedAt             TimestamptzString  @map("updated_at")
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "account_userId_fkey")

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model Session {
  id        String            @id(map: "session_pkey")
  expiresAt TimestamptzString @map("expires_at")
  token     String            @unique(map: "session_token_key")
  createdAt TimestamptzString @default(now()) @map("created_at")
  updatedAt TimestamptzString @map("updated_at")
  ipAddress String?           @map("ip_address")
  userAgent String?           @map("user_agent")
  userId    String            @map("user_id")
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "session_userId_fkey")

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Verification {
  id         String            @id(map: "verification_pkey")
  identifier String
  value      String
  expiresAt  TimestamptzString @map("expires_at")
  createdAt  TimestamptzString @default(now()) @map("created_at")
  updatedAt  TimestamptzString @default(now()) @map("updated_at")

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}
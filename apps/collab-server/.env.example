# Copy to `.env` and fill in real values. Never commit real secrets.

# PostgreSQL connection (Prisma ORM document persistence).
DATABASE_URL=postgresql://user:password@localhost:5433/codiooo

# Shared collaboration token secret. Must be identical to
# COLLAB_TOKEN_SECRET in apps/web. Generate with: openssl rand -base64 48
COLLAB_TOKEN_SECRET=replace-with-a-48-character-secret

# WebSocket server port.
PORT=1234
